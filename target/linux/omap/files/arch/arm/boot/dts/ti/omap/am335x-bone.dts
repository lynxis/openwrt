&baseboard_eeprom {
	vcc-supply = <&ldo4_reg>;
};

&mmc1 {
	status = "disabled";
};

&mmc2 {
	status = "disabled";
};

&am33xx_pinmux {
	gpmc_pins: gmpc_pins {
		pinctrl-single,pins = <
			/* hdmi pins as GPMC_A0-15 */
			AM33XX_PADCONF(AM335X_PIN_LCD_DATA0, PIN_OUTPUT, MUX_MODE1)  /* a0 - NC */
			AM33XX_PADCONF(AM335X_PIN_LCD_DATA1, PIN_OUTPUT, MUX_MODE1)
			AM33XX_PADCONF(AM335X_PIN_LCD_DATA2, PIN_OUTPUT, MUX_MODE1)
			AM33XX_PADCONF(AM335X_PIN_LCD_DATA3, PIN_OUTPUT, MUX_MODE1)
			AM33XX_PADCONF(AM335X_PIN_LCD_DATA4, PIN_OUTPUT, MUX_MODE1)
			AM33XX_PADCONF(AM335X_PIN_LCD_DATA5, PIN_OUTPUT, MUX_MODE1)
			AM33XX_PADCONF(AM335X_PIN_LCD_DATA6, PIN_OUTPUT, MUX_MODE1)
			AM33XX_PADCONF(AM335X_PIN_LCD_DATA7, PIN_OUTPUT, MUX_MODE1)  /* a7 */
			AM33XX_PADCONF(AM335X_PIN_LCD_DATA8, PIN_OUTPUT, MUX_MODE1)  /* a12 */
			AM33XX_PADCONF(AM335X_PIN_LCD_DATA9, PIN_OUTPUT, MUX_MODE1)  /* a13 */
			AM33XX_PADCONF(AM335X_PIN_LCD_DATA10, PIN_OUTPUT, MUX_MODE1) /* a14 */
			AM33XX_PADCONF(AM335X_PIN_LCD_DATA11, PIN_OUTPUT, MUX_MODE1) /* a15 */
			AM33XX_PADCONF(AM335X_PIN_LCD_DATA12, PIN_OUTPUT, MUX_MODE1) /* a16 */
			AM33XX_PADCONF(AM335X_PIN_LCD_DATA13, PIN_OUTPUT, MUX_MODE1) /* a17 */
			AM33XX_PADCONF(AM335X_PIN_LCD_DATA14, PIN_OUTPUT, MUX_MODE1) /* a18 */
			AM33XX_PADCONF(AM335X_PIN_LCD_DATA15, PIN_OUTPUT, MUX_MODE1) /* a19 */
			AM33XX_PADCONF(AM335X_PIN_LCD_VSYNC, PIN_OUTPUT, MUX_MODE1) /* a8 */
			AM33XX_PADCONF(AM335X_PIN_LCD_HSYNC, PIN_OUTPUT, MUX_MODE1) /* a9 */
			AM33XX_PADCONF(AM335X_PIN_LCD_PCLK, PIN_OUTPUT, MUX_MODE1) /* a10 */
			AM33XX_PADCONF(AM335X_PIN_LCD_AC_BIAS_EN, PIN_OUTPUT, MUX_MODE1) /* a11 */

			/* emmc-pins */
			/* AM33XX_PADCONF(AM335X_PIN_GPMC_CSN1, PIN_INPUT_PULLUP, MUX_MODE0) */ /* gpmc_csn1 */
			/* AM33XX_PADCONF(AM335X_PIN_GPMC_CSN2, PIN_INPUT_PULLUP, MUX_MODE0) */ /* gpmc_csn2 */
			AM33XX_PADCONF(AM335X_PIN_GPMC_AD0, PIN_INPUT_PULLUP, MUX_MODE0) /* gpmc_ad0 */
			AM33XX_PADCONF(AM335X_PIN_GPMC_AD1, PIN_INPUT_PULLUP, MUX_MODE0) /* gpmc_ad1 */
			AM33XX_PADCONF(AM335X_PIN_GPMC_AD2, PIN_INPUT_PULLUP, MUX_MODE0) /* gpmc_ad2 */
			AM33XX_PADCONF(AM335X_PIN_GPMC_AD3, PIN_INPUT_PULLUP, MUX_MODE0) /* gpmc_ad3 */
			AM33XX_PADCONF(AM335X_PIN_GPMC_AD4, PIN_INPUT_PULLUP, MUX_MODE0) /* gpmc_ad4 */
			AM33XX_PADCONF(AM335X_PIN_GPMC_AD5, PIN_INPUT_PULLUP, MUX_MODE0) /* gpmc_ad5 */
			AM33XX_PADCONF(AM335X_PIN_GPMC_AD6, PIN_INPUT_PULLUP, MUX_MODE0) /* gpmc_ad6 */
			AM33XX_PADCONF(AM335X_PIN_GPMC_AD7, PIN_INPUT_PULLUP, MUX_MODE0) /* gpmc_ad7 */

			/* extra pins */
			AM33XX_PADCONF(AM335X_PIN_GPMC_AD8, PIN_INPUT_PULLUP, MUX_MODE0) /* EHRPWM2A */
			AM33XX_PADCONF(AM335X_PIN_GPMC_AD9, PIN_INPUT_PULLUP, MUX_MODE0) /* EHRPWM2B */
			AM33XX_PADCONF(AM335X_PIN_GPMC_AD10, PIN_INPUT_PULLUP, MUX_MODE0) /* GPIO0_26 */
			AM33XX_PADCONF(AM335X_PIN_GPMC_AD11, PIN_INPUT_PULLUP, MUX_MODE0) /* GPIO0_27 */
			AM33XX_PADCONF(AM335X_PIN_GPMC_AD12, PIN_INPUT_PULLUP, MUX_MODE0) /* GPIO1_12 */
			AM33XX_PADCONF(AM335X_PIN_GPMC_AD13, PIN_INPUT_PULLUP, MUX_MODE0) /* GPIO1_13 */
			AM33XX_PADCONF(AM335X_PIN_GPMC_AD14, PIN_INPUT_PULLUP, MUX_MODE0) /* GPIO1_14 */
			AM33XX_PADCONF(AM335X_PIN_GPMC_AD15, PIN_INPUT_PULLUP, MUX_MODE0) /* GPIO1_15 */


			/* sdcard pins - use it as A20-A25*/
			/* AM33XX_PADCONF(AM335X_PIN_SPI0_CS1, PIN_INPUT, MUX_MODE7) */		/* spio0_cs1.gpio0_6 */
			AM33XX_PADCONF(AM335X_PIN_MMC0_DAT0, PIN_OUTPUT, MUX_MODE1) /* a23 */
			AM33XX_PADCONF(AM335X_PIN_MMC0_DAT1, PIN_OUTPUT, MUX_MODE1) /* a22 */
			AM33XX_PADCONF(AM335X_PIN_MMC0_DAT2, PIN_OUTPUT, MUX_MODE1) /* a21 */
			AM33XX_PADCONF(AM335X_PIN_MMC0_DAT3, PIN_OUTPUT, MUX_MODE1) /* a20 */
			AM33XX_PADCONF(AM335X_PIN_MMC0_CMD, PIN_OUTPUT, MUX_MODE1) /* a25 */
			AM33XX_PADCONF(AM335X_PIN_MMC0_CLK, PIN_OUTPUT, MUX_MODE1) /* a24 */

			/* A26 is missing! use a gpio for it */
			/* or take A10 in MUX_MODE4 */
			AM33XX_PADCONF(AM335X_PIN_GPMC_A10, PIN_OUTPUT, MUX_MODE4) /* a10 as a26. desolder TPS2051/U8 */

			AM33XX_PADCONF(AM335X_PIN_GPMC_WEN, PIN_OUTPUT, MUX_MODE0) /* TIMER6 */
			AM33XX_PADCONF(AM335X_PIN_GPMC_OEN_REN, PIN_OUTPUT, MUX_MODE0) /* TIMER7 */
			AM33XX_PADCONF(AM335X_PIN_GPMC_CSN0, PIN_OUTPUT, MUX_MODE0) /* GPIO1_29 */
			AM33XX_PADCONF(AM335X_PIN_GPMC_WAIT0, PIN_INPUT, MUX_MODE0) /* UART4_RXD */

			/* ensure the emmc is in reset */
			AM33XX_PADCONF(AM335X_PIN_GPMC_A4, PIN_OUTPUT_PULLUP, MUX_MODE7) /* emmc reset */
			AM33XX_PADCONF(AM335X_PIN_GPMC_A11, PIN_OUTPUT_PULLUP, MUX_MODE7) /* hdmi clk reset */
			AM33XX_PADCONF(AM335X_PIN_GPMC_BE1N, PIN_OUTPUT_PULLUP, MUX_MODE7) /* nor reset */
		>;
	};
};

&gpio1 {
	emmc_reset {
		gpio-hog;
		gpios = <20 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "emmc_reset";
	};
	hdmi_clk_reset {
		gpio-hog;
		gpios = <27 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "hdmi_clk_reset";
	};
	nor_reset {
		gpio-hog;
		gpios = <28 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "nor_reset";
	};
};

&gpmc {
	compatible = "ti,am3352-gpmc";
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&gpmc_pins>;

	ranges = <0 0 0x10000000 0x08000000>;	/* CS0: NOR 128M */

	nor@0,0 {
		reg = <0 0x00000000 0x08000000>;
		compatible = "cfi-flash";
		linux,mtd-name = "spansion,s29gl010p11t"; /* fixme check diff 11t vs 01t */
		bank-width = <2>;

		gpmc,device-width = <2>;
		gpmc,mux-add-data = <0>;

		gpmc,cs-on-ns = <40>;
		gpmc,cs-rd-off-ns = <160>;
		gpmc,cs-wr-off-ns = <160>;
		gpmc,adv-on-ns = <40>;
		gpmc,adv-rd-off-ns = <40>;
		gpmc,adv-wr-off-ns = <40>;
		gpmc,oe-on-ns = <160>;
		gpmc,oe-off-ns = <160>;
		gpmc,we-on-ns = <160>;
		gpmc,we-off-ns = <160>;
		gpmc,rd-cycle-ns = <160>;
		gpmc,wr-cycle-ns = <160>;
		gpmc,access-ns = <160>;
		gpmc,page-burst-access-ns = <40>;
		gpmc,cycle2cycle-samecsen;
		gpmc,cycle2cycle-delay-ns = <40>;
		gpmc,wr-data-mux-bus-ns = <140>;
		gpmc,wr-access-ns = <160>;

		rb-gpios = <&gpmc 0 GPIO_ACTIVE_LOW>; /* gpmc_wait0 pin */

		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "full";
			reg = <0x00000000 0x8000000>; /* 128 MByte */
			read-only;
		};
	};
};
