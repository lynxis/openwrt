Index: linux-5.15.137/arch/x86/entry/vdso/Makefile
===================================================================
--- linux-5.15.137.orig/arch/x86/entry/vdso/Makefile
+++ linux-5.15.137/arch/x86/entry/vdso/Makefile
@@ -178,7 +178,7 @@ quiet_cmd_vdso = VDSO    $@
 		       -T $(filter %.lds,$^) $(filter %.o,$^) && \
 		 sh $(srctree)/$(src)/checkundef.sh '$(NM)' '$@'
 
-VDSO_LDFLAGS = -shared --hash-style=both --build-id=sha1 \
+VDSO_LDFLAGS = -shared --hash-style=both --build-id=none \
